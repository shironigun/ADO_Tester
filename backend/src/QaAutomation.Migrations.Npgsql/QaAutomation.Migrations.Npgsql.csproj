<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PostgreSQL-only EF Core migrations assembly (dual-provider migration).
    Kept SEPARATE from the SQLite migrations in QaAutomation.Infrastructure/Data/Migrations
    because EF migrations are provider-specific and the two sets cannot share a model snapshot.
    Selected at runtime and design-time via MigrationsAssembly("QaAutomation.Migrations.Npgsql").

    To generate the initial migration locally, run from the backend/ folder:
      dotnet sln add src/QaAutomation.Migrations.Npgsql
      set DATABASE_PROVIDER=postgres and run:
        dotnet ef migrations add InitialNpgsql
        with -p src/QaAutomation.Migrations.Npgsql -s src/QaAutomation.Api
    The Npgsql provider is available transitively via the Infrastructure reference.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QaAutomation.Infrastructure\QaAutomation.Infrastructure.csproj" />
  </ItemGroup>

</Project>
