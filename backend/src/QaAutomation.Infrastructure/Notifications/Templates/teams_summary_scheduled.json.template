{
  "type": "message",
  "attachments": [
    {
      "contentType": "application/vnd.microsoft.card.adaptive",
      "content": {
        "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
        "type": "AdaptiveCard",
        "version": "1.4",
        "body": [
          {
            "type": "TextBlock",
            "text": "Good day, Mahmood — here is your scheduled QA Loop summary.",
            "wrap": true,
            "size": "Medium"
          },
          {
            "type": "TextBlock",
            "text": "**Module:** {{module}}  |  **Profile:** {{profile}}  |  **Env:** {{env}}",
            "wrap": true,
            "separator": true
          },
          {
            "type": "ColumnSet",
            "separator": true,
            "columns": [
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  { "type": "TextBlock", "text": "**Passed**", "weight": "Bolder" },
                  { "type": "TextBlock", "text": "{{passed}}", "size": "ExtraLarge", "color": "Good" }
                ]
              },
              {
                "type": "Column",
                "width": "stretch",
                "items": [
                  { "type": "TextBlock", "text": "**Failed**", "weight": "Bolder" },
                  { "type": "TextBlock", "text": "{{failed}}", "size": "ExtraLarge", "color": "{{failed_color}}" }
                ]
              }
            ]
          },
          {
            "type": "TextBlock",
            "text": "**Results by level**",
            "weight": "Bolder",
            "separator": true
          },
          {
            "type": "TextBlock",
            "text": "{{level_table}}",
            "wrap": true,
            "fontType": "Monospace"
          },
          {
            "type": "TextBlock",
            "text": "Duration: {{duration}}",
            "wrap": true,
            "separator": true,
            "isSubtle": true
          }
        ],
        "actions": [
          {
            "type": "Action.OpenUrl",
            "title": "View ADO Test Run",
            "url": "{{ado_run_url}}"
          },
          {
            "type": "Action.OpenUrl",
            "title": "Email Mahmood",
            "url": "mailto:Mahmood Ahmad?subject=QA%20Loop%20Run%20%E2%80%94%20{{module}}&body={{email_body}}"
          }
        ]
      }
    }
  ]
}
