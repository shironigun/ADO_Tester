# Copy this file to ".env" and fill in real values. .env is git-ignored — never commit secrets.

# === Database ===========================================================================
# PostgreSQL is required. Set POSTGRES_CONNECTION_STRING (or DATABASE_URL) before starting the app.
# Local Docker setup: docs/setup/postgresql-docker.md
# Local Docker example:
#   Host=localhost;Port=5432;Database=qa;Username=qa;Password=qa
# Azure adds TLS:  ...;SSL Mode=Require;Trust Server Certificate=true
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=qa;Username=qa;Password=qa

# === App login (web UI username/password gate) =========================================
# Protect the web UI with a single username + password. Set BOTH to turn the login screen on;
# leave either blank to run open (no login). These are DISTINCT from the QA Loop AUTH_* creds
# below (which mint automation bearer tokens). Applies to Docker and local runs alike.
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=
# Optional explicit on/off (true|false). Default: enabled only when username AND password are set.
# APP_LOGIN_ENABLED=
# Login issues a JWT (sent as a Bearer token; also via ?access_token= for SSE/iframe requests).
# Optional HS256 secret — if blank, a stable key is derived from the credentials. Set a strong value
# to sign tokens independently of the password.
# APP_LOGIN_JWT_SECRET=
# Token lifetime in minutes before re-login is required (default 720 = 12h).
# APP_LOGIN_TOKEN_MINUTES=720

# Azure DevOps Personal Access Token. Scopes: Work Items R/W, Code Read (add Test Management R/W for S2).
ADOACCESS_PAT=your-azure-devops-pat-here

# Anthropic API key (https://console.anthropic.com). Used when Llm:Provider = Anthropic.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Azure OpenAI (used when Llm:Provider = AzureOpenAI). Endpoint also works for OpenAI-compatible
# gateways (e.g. GitHub Models). Deployment = the model deployment name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# OpenAI-compatible (used when Llm:Provider = OpenAICompatible).
# FREE option = GitHub Models: BASE_URL below + a GitHub PAT as the key (github.com/settings/tokens).
# Also works for Groq / OpenRouter / OpenAI — just change BASE_URL + key + model.
OPENAI_BASE_URL=https://models.inference.ai.azure.com
OPENAI_API_KEY=your-github-pat-or-openai-key
OPENAI_MODEL=gpt-4o-mini

# Native Ollama (used when Llm:Provider = Ollama).
# Local: http://localhost:11434/api (API key optional).
# Cloud: https://ollama.com/api (API key required).
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_MODEL=llama3.2

# Claude CLI (used when Llm:Provider = ClaudeCli) — uses your local `claude` CLI login
# (Pro/Max subscription). No API key needed. Single-user local only.
# CLAUDE_CLI_PATH=claude         # path to the CLI; defaults to PATH lookup
CLAUDE_CLI_MODEL=claude-opus-4-8  # 1M-context model (use for large tickets); blank = CLI default, e.g. haiku/sonnet = 200k
CLAUDE_CLI_EFFORT=high            # reasoning effort → --effort: low|medium|high|max
# CLAUDE_CLI_TIMEOUT_SECONDS=180

# Cursor Agent CLI (used when Llm:Provider = CursorCli) — local `agent` / `cursor-agent`
# (not the IDE cursor.exe). Auth: `agent login` or CURSOR_API_KEY. Headless -p mode uses a
# scratch workspace under Storage:DataDirectory so prompts do not edit this repo.
# See docs/setup/cursor-cli.md. AppBar model/effort/context chips are display-only — edit in Settings.
# CURSOR_CLI_PATH=               # blank = auto-detect agent / cursor-agent
# CURSOR_CLI_MODEL=              # blank → auto; ids from `agent --list-models`
# CURSOR_CLI_EFFORT=             # optional → --model id[effort=…]
# CURSOR_CLI_CONTEXT=            # optional → --model id[context=…] (e.g. 1m)
# CURSOR_CLI_TIMEOUT_SECONDS=180
# CURSOR_API_KEY=                # optional if not using `agent login`

# GitHub Copilot CLI (used when Llm:Provider = CopilotCli) — uses your GitHub Copilot subscription.
# Set COPILOT_GITHUB_TOKEN to a FINE-GRAINED GitHub PAT (starts with github_pat_). Classic PATs
# (ghp_) are REJECTED by the Copilot CLI. The token MUST have the "Copilot Requests" account
# permission (Read-only) enabled, or auth fails. Create one at:
#   https://github.com/settings/personal-access-tokens/new  → Account permissions → Copilot Requests
# Alternatives: set GH_TOKEN/GITHUB_TOKEN (also fine-grained), or run 'copilot' + '/login' interactively.
COPILOT_GITHUB_TOKEN=github_pat_your-fine-grained-token-here
# COPILOT_CLI_PATH=copilot       # path to the CLI; defaults to PATH lookup + known install dirs
# COPILOT_CLI_MODEL=             # blank = CLI default; e.g. claude-opus-4.8, claude-sonnet-4.6
# COPILOT_CLI_EFFORT=            # reasoning effort → --effort: none|minimal|low|medium|high|xhigh|max
# COPILOT_CLI_CONTEXT=           # context size → --context: default (200k) | long_context (1M)
# COPILOT_CLI_TIMEOUT_SECONDS=180

# QA Loop: run profile is a label (AUTOMATION_PROFILE) for Allure / future per-profile login identity.
# API host is ALWAYS the shared AUTOMATION_API_BASE_URL — not per-profile *_BASE_URL tokens.

# SHARED automation target + pre-run auth (same host for every target).
# AUTOMATION_API_BASE_URL → child env AUTOMATION_BASE_URL + BASE_URL (API specs call this host).
# WEB_API_BASE_URL        → mints the bearer (POST {WEB_API_BASE_URL}/Authentication/authentication).
# AUTH_*                  → default mint identity (profile-specific overrides can be added later).
AUTOMATION_API_BASE_URL=https://your-qa-api-gateway-here
WEB_API_BASE_URL=https://your-qa-web-api-here/api/v1
AUTH_ACCOUNT_ID=your-account-id-here
AUTH_USERNAME=your-automation-username
AUTH_PASSWORD=your-automation-password

# UI automation (Playwright storageState via scripts/fixtures/auth.setup.ts).
AUTOMATION_APP_URL=https://your-qa-frontend-here
AUTOMATION_APP_USERNAME=
AUTOMATION_APP_PASSWORD=
# Root for agent-generated UI specs (.ui.spec.ts). Often backend/data/playwright-runtime.
# AUTOMATION_PLAYWRIGHT_ROOT=
# Absolute path to the product {repo}/automation/ framework (Scripts Board + structured Push).
# Empty = legacy private scripts / derived FrontendRoot sibling. Settings key: qaloop.automation_root.
# AUTOMATION_ROOT=
# Optional Azure DevOps URL for the product automation pipeline (Push deep-link).
# AUTOMATION_PIPELINE_URL=
# Product-repo base branch for “Sync from …” on Push (default qa).
# AUTOMATION_BASE_BRANCH=qa

# === Prompt identity (injected into agent system prompts at load) =======================
# Restores product/org/author names into the generic committed prompts, so generated test
# cases & bug reports read in your house voice. Leave blank to keep the neutral wording
# ("the application" / "the organization" / "the lead QA analyst").
PROMPT_PRODUCT=
PROMPT_ORG=
PROMPT_QA_AUTHOR=

# === Azure DevOps org/project (committed code ships blank; set your real values) =======
ADO_ORGANIZATION= 
ADO_PROJECT=
ADO_REPOSITORY=
ADO_BUG_AREA_PATH=

# === QA Loop frontend-scan source ======================================================
QALOOP_FRONTEND_REPO=
QALOOP_FRONTEND_ROOT=
QALOOP_FRONTEND_BASE_URL=

