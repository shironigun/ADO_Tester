# Copy this file to ".env" and fill in real values. .env is git-ignored — never commit secrets.

# === Database provider ==================================================================
# Which database backs the app. Default (unset or "sqlite") = the local SQLite file DB — no extra
# setup. Set to "postgres" for PostgreSQL (local Docker for dev, Azure Database for PostgreSQL in
# prod). Switching providers requires an app restart. See docs/setup/postgresql-docker.md.
DATABASE_PROVIDER=sqlite
# Npgsql connection string — required only when DATABASE_PROVIDER=postgres. Local Docker example:
#   Host=localhost;Port=5432;Database=qa;Username=qa;Password=qa
# Azure adds TLS:  ...;SSL Mode=Require;Trust Server Certificate=true
# POSTGRES_CONNECTION_STRING=

# === App login (web UI username/password gate) =========================================
# Protect the web UI with a single username + password. Set BOTH to turn the login screen on;
# leave either blank to run open (no login). These are DISTINCT from the QA Loop AUTH_* creds
# below (which mint automation bearer tokens). Applies to Docker and local runs alike.
APP_LOGIN_USERNAME=
APP_LOGIN_PASSWORD=
# Optional explicit on/off (true|false). Default: enabled only when username AND password are set.
# APP_LOGIN_ENABLED=
# Login issues a JWT (sent as a Bearer token; also via ?access_token= for SSE/iframe requests).
# Optional HS256 secret — if blank, a stable key is derived from the credentials. Set a strong value
# to sign tokens independently of the password.
# APP_LOGIN_JWT_SECRET=
# Token lifetime in minutes before re-login is required (default 720 = 12h).
# APP_LOGIN_TOKEN_MINUTES=720

# Azure DevOps Personal Access Token. Scopes: Work Items R/W, Code Read (add Test Management R/W for S2).
ADOACCESS_PAT=your-azure-devops-pat-here

# Anthropic API key (https://console.anthropic.com). Used when Llm:Provider = Anthropic.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Azure OpenAI (used when Llm:Provider = AzureOpenAI). Endpoint also works for OpenAI-compatible
# gateways (e.g. GitHub Models). Deployment = the model deployment name.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# OpenAI-compatible (used when Llm:Provider = OpenAICompatible).
# FREE option = GitHub Models: BASE_URL below + a GitHub PAT as the key (github.com/settings/tokens).
# Also works for Groq / OpenRouter / OpenAI / local Ollama — just change BASE_URL + key + model.
OPENAI_BASE_URL=https://models.inference.ai.azure.com
OPENAI_API_KEY=your-github-pat-or-openai-key
OPENAI_MODEL=gpt-4o-mini

# Claude CLI (used when Llm:Provider = ClaudeCli) — uses your local `claude` CLI login
# (Pro/Max subscription). No API key needed. Single-user local only.
# CLAUDE_CLI_PATH=claude         # path to the CLI; defaults to PATH lookup
# CLAUDE_CLI_MODEL=              # blank = CLI default; can pin a model
# CLAUDE_CLI_TIMEOUT_SECONDS=180

# GitHub Copilot CLI (used when Llm:Provider = CopilotCli) — uses your GitHub Copilot subscription.
# No API key needed. Run `copilot auth login` once to authenticate.
# Docker: docker compose exec backend copilot auth login
# COPILOT_CLI_PATH=copilot       # path to the CLI; defaults to PATH lookup + known install dirs
# COPILOT_CLI_MODEL=             # blank = CLI default (gpt-4o)
# COPILOT_CLI_TIMEOUT_SECONDS=180

# QA Loop (QAL-068): DMS profile target URLs for the Playwright runner. Each generated spec reads
# process.env.AUTOMATION_BASE_URL for its target host and process.env.AUTOMATION_BEARER_TOKEN for
# auth — PlaywrightRunner sets both on the child process env from whichever profile the run picked
# (see DmsProfileOptions.All). Unset = generated specs run with an empty base URL and fail fast
# instead of silently hitting localhost or a guessed hostname.
INFINITY_BASE_URL=
INFINITY_BEARER_TOKEN=
# IDEAL_BASE_URL=
# ASPEN_BASE_URL=
# QUANTUM_BASE_URL=

# QA Loop (QAL-072): SHARED automation target + pre-run auth. Preferred over the per-DMS
# *_BASE_URL/*_BEARER_TOKEN block above — the QA API base URL is the SAME for every DMS (one APIM
# gateway), and the bearer is minted once per run by logging in with the AUTH_* creds below.
# LEAD_API_BASE_URL → set on the run as AUTOMATION_BASE_URL (deals API the specs call).
# WEB_API_BASE_URL  → mints the bearer token (POST {WEB_API_BASE_URL}/Authentication/authentication).
LEAD_API_BASE_URL=https://your-qa-api-gateway-here/lead-api
WEB_API_BASE_URL=https://your-qa-web-api-here/api/v1

# Shared QA-admin credentials the pre-run auth step logs in with (also used to mint the bearer).
AUTH_DEALER_ID=99201001
AUTH_USERNAME=admin
AUTH_PASSWORD=123
TEST_DEALER_ID=

# === Prompt identity (injected into agent system prompts at load) =======================
# Restores product/org/author names into the generic committed prompts, so generated test
# cases & bug reports read in your house voice. Leave blank to keep the neutral wording
# ("the application" / "the organization" / "the lead QA analyst").
PROMPT_PRODUCT=
PROMPT_ORG=
PROMPT_QA_AUTHOR=

# === Azure DevOps org/project (committed code ships blank; set your real values) =======
ADO_ORGANIZATION= 
ADO_PROJECT=
ADO_REPOSITORY=
ADO_BUG_AREA_PATH=

# === QA Loop frontend-scan source ======================================================
QALOOP_FRONTEND_REPO=
QALOOP_FRONTEND_ROOT=
QALOOP_FRONTEND_BASE_URL=

